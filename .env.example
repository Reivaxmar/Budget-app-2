# Copy this file to .env.local (git-ignored) for local development, or set
# these as CI/CD environment variables when building for release. See
# DIST.md -> "Supabase setup" for where to find these values and what they
# do. Both are safe to expose in a shipped build -- the anon key only grants
# what Row Level Security policies in supabase/schema.sql allow.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
